<?xml version="1.0"?>
<sdf version="1.7">
  <world name="underwater">
    <!-- 关闭重力，使 set_model_state 速度控制更稳定（AUV 不会持续下沉） -->
    <gravity>0 0 0</gravity>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- 水下雾效与暗色背景，模拟浑浊水体 -->
    <scene>
      <ambient>0.12 0.12 0.16 1</ambient>
      <background>0.05 0.09 0.14 1</background>
      <fog>
        <color>0.45 0.55 0.6 1</color>
        <type>linear</type>
        <density>0.02</density>
        <start>1.0</start>
        <end>25.0</end>
      </fog>
    </scene>

    <!-- 水下光照（关闭阴影以降低开销） -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.6 0.7 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 -0.4 -1</direction>
    </light>

    <!-- Gazebo-ROS 桥接插件：提供 /gazebo/set_model_state 等服务 -->
    <plugin name="gazebo_ros_api_plugin" filename="libgazebo_ros_api_plugin.so"/>

    <!-- 海底地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.10 0.12 0.15 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- AUV 模型（名称必须为 'auv'，与 auv_vel_ctrl 默认 model_name 一致） -->
    <model name="auv">
      <pose>0 0 0.5 0 0 0</pose>
      <link name="chassis">
        <collision name="coll">
          <geometry><box><size>1.0 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.0 0.6 0.4</size></box></geometry>
          <material><diffuse>0.9 0.6 0.1 1</diffuse></material>
        </visual>
        <!-- 前向相机：cameraName=auv/camera -> 图像话题 /auv/camera/image_raw -->
        <sensor name="camera" type="camera">
          <pose>0.5 0 0.1 0 1.5708 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>50</far></clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <cameraName>auv/camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <updateRate>15.0</updateRate>
            <frameName>auv/camera</frameName>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- 前方暗色障碍墙：用于视觉避障演示（灰度极低，被 obstacle_avoid 识别） -->
    <model name="obstacle_wall">
      <static>true</static>
      <pose>8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="coll">
          <geometry><box><size>0.3 4 2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 4 2</size></box></geometry>
          <material><diffuse>0.02 0.02 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
